        ],
        "title": "ReasonCodeOut",
        "type": "object"
      },
      "ScoreRequest": {
        "additionalProperties": false,
        "description": "One transaction to score.\n\n``card_id`` must be an HMAC token (``c_`` and 16 hex characters), so a raw card number\nis rejected at the door. An unknown ``category`` is scored as ``unknown``. Optional\nfields that are missing are passed to the model as missing values.",
        "properties": {
          "amount": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000000.0,
            "title": "Amount",
            "type": "number"
          },
          "card_id": {
            "pattern": "^c_[0-9a-f]{16}$",
            "title": "Card Id",
            "type": "string"
          },
          "cardholder_age": {
            "anyOf": [
              {
                "maximum": 130.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cardholder Age"
          },
          "category": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "city_pop": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "City Pop"
          },
          "event_time": {
            "format": "date-time",
            "title": "Event Time",
            "type": "string"
          },
          "home_lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Lat"
          },
          "home_long": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Long"
          },
          "merchant_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Merchant Id",
            "type": "string"
          },
          "merchant_lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant Lat"
          },
          "merchant_long": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant Long"
          },
          "transaction_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "card_id",
          "event_time",
          "amount",
          "category",
          "merchant_id"
        ],
        "title": "ScoreRequest",
        "type": "object"
      },
      "ScoreResponse": {
        "description": "The decision for one transaction.",
        "properties": {
          "decision": {
            "enum": [
              "approve",
