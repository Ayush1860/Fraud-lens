            },
            "title": "Reason Codes",
            "type": "array"
          },
          "risk_score": {
            "title": "Risk Score",
            "type": "number"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "risk_score",
          "decision",
          "model_version",
          "degraded",
          "reason_codes",
          "latency_ms"
        ],
