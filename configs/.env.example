# Copy to .env in the repository root (`make setup` does this). Never commit .env.
# Every value below is a local-development placeholder, not a secret.

# --- Docker Compose: Postgres container ---
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=fraudlens

# --- FraudLens settings (src/fraudlens/common/settings.py) ---
FRAUDLENS_ENVIRONMENT=local
FRAUDLENS_LOG_LEVEL=INFO
FRAUDLENS_API_KEY=local-dev-only-change-me
FRAUDLENS_CARD_HMAC_KEY=local-dev-only-change-me
FRAUDLENS_DATABASE_URL=postgresql+asyncpg://fraudlens:local-dev-only-change-me@localhost:5432/fraudlens
FRAUDLENS_REDIS_URL=redis://localhost:6379/0
